# /var/www/zvoni/apps/api/.env
# Заменить все значения в < > перед деплоем

DATABASE_URL="postgresql://zvoni:СИЛЬНЫЙ_ПАРОЛЬ@localhost:5433/zvoni"
REDIS_URL="redis://localhost:6380"

# Минимум 64 случайных символа: openssl rand -hex 32
JWT_SECRET="СГЕНЕРИРУЙ_ЧЕРЕЗ_openssl_rand_hex_32"
JWT_EXPIRES_IN="7d"

# LiveKit — ключи должны совпадать с livekit.yaml
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="zvonikey"
LIVEKIT_API_SECRET="zvonisecret_change_in_production_min32chars"

API_PORT=3001
FRONTEND_URL="https://po-zvoni.ru"
NODE_ENV="production"
